// Діаграма класів для class-diagram.png (Graphviz):
//   dot -Tpng class-diagram.dot -o class-diagram.png
// Зміст той самий, що й у class-diagram.puml.
digraph Builder {
  graph [label="Лабораторна №2. Builder: пакування подарункових наборів", labelloc=t, fontname="Sans Bold", fontsize=16,
         rankdir=TB, nodesep=0.5, ranksep=0.9, pad=0.3, bgcolor=white];
  node  [shape=plain, fontname="Sans", fontsize=11];
  edge  [fontname="Sans", fontsize=10, labeldistance=2.2, labelangle=25];

  BoxBuilder [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef3fb">
      <tr><td><i>«Builder»</i><br/><b><i>BoxBuilder</i></b></td></tr>
      <tr><td border="1" sides="T" align="left" balign="left">-pieces : Map&lt;CandyType, number&gt;</td></tr>
      <tr><td border="1" sides="T" align="left" balign="left"><i>+name : string</i><br/><i>+addLollipops()</i><br/><i>+addChocolates()</i><br/><i>+addWaffles()</i><br/><i>+addDragee()</i><br/>+reset()<br/>+putPieces(type, pieces)<br/>+getResult(pricePerKg) : GiftBox</td></tr>
    </table>>];

  LasunkaBuilder [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#f5f5f5">
      <tr><td><i>«ConcreteBuilder»</i><br/><b>LasunkaBuilder</b></td></tr>
    </table>>];
  NaminaikoBuilder [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#f5f5f5">
      <tr><td><i>«ConcreteBuilder»</i><br/><b>NaminaikoBuilder</b></td></tr>
    </table>>];
  PanKotskyBuilder [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#f5f5f5">
      <tr><td><i>«ConcreteBuilder»</i><br/><b>PanKotskyBuilder</b></td></tr>
    </table>>];

  PackingLine [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fff6e0">
      <tr><td><i>«Director»</i><br/><b>PackingLine</b></td></tr>
      <tr><td border="1" sides="T" align="left" balign="left">-pricePerKg : number</td></tr>
      <tr><td border="1" sides="T" align="left" balign="left">+pack(builder) : GiftBox</td></tr>
    </table>>];

  PackingMenu [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eaf7ea">
      <tr><td><i>«Client»</i><br/><b>PackingMenu</b></td></tr>
      <tr><td border="1" sides="T" align="left" balign="left">+run()</td></tr>
    </table>>];

  GiftBox [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fbeeee">
      <tr><td><i>«Product»</i><br/><b>GiftBox</b></td></tr>
      <tr><td border="1" sides="T" align="left" balign="left">+name : string<br/>+pricePerKg : number<br/>-pieces : Map&lt;CandyType, number&gt;</td></tr>
      <tr><td border="1" sides="T" align="left" balign="left">+getPieces(type) : number<br/>+getWeightOf(type) : number<br/>+getWeight() : number<br/>+getPrice() : number</td></tr>
    </table>>];

  CandyType [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#f5f5f5">
      <tr><td><b>CandyType</b></td></tr>
      <tr><td border="1" sides="T" align="left" balign="left"><u>+LOLLIPOP : CandyType</u><br/><u>+CHOCOLATE : CandyType</u><br/><u>+WAFFLE : CandyType</u><br/><u>+DRAGEE : CandyType</u><br/>+title : string<br/>+pieceWeight : number</td></tr>
    </table>>];

  BoxBuilder -> LasunkaBuilder [dir=back, arrowtail=onormal];
  BoxBuilder -> NaminaikoBuilder [dir=back, arrowtail=onormal];
  BoxBuilder -> PanKotskyBuilder [dir=back, arrowtail=onormal];

  PackingMenu -> PackingLine [arrowhead=vee, label="packingLine", headlabel="1"];
  PackingMenu -> BoxBuilder [arrowhead=vee, arrowtail=odiamond, dir=both, label="builders", headlabel="3"];
  PackingLine -> BoxBuilder [arrowhead=vee, style=dashed, label="керує кроками"];
  BoxBuilder -> GiftBox [arrowhead=vee, style=dashed, label="«create»"];
  GiftBox -> CandyType [arrowhead=vee, arrowtail=odiamond, dir=both, label="pieces", headlabel="4"];
  BoxBuilder -> CandyType [arrowhead=vee, style=dashed];
}
